{
	"name": "@jayden/jai-desktop",
	"version": "0.0.0",
	"private": true,
	"description": "JAI desktop application",
	"main": ".vite/build/main.js",
	"scripts": {
		"prepare-runtime": "bun run --cwd ../server build && bun electron/runtime-host/stop-running-host.mts",
		"dev": "bun run prepare-runtime && electron-forge start",
		"build": "bun run prepare-runtime && electron-forge package",
		"make": "bun run prepare-runtime && electron-forge make",
		"test": "bun test",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"i18n:extract": "formatjs extract \"src/**/*.{ts,tsx}\" --out-file src/i18n/messages/en.json",
		"i18n:compile": "bun src/i18n/compile-catalog.ts",
		"i18n:validate": "bun src/i18n/validate-catalog.ts"
	},
	"dependencies": {
		"@atlaskit/pragmatic-drag-and-drop": "^3.1.0",
		"@atlaskit/pragmatic-drag-and-drop-hitbox": "^2.2.2",
		"@base-ui/react": "^1.4.0",
		"@hugeicons/core-free-icons": "^4.1.1",
		"@hugeicons/react": "^1.1.6",
		"@jai/agent": "workspace:*",
		"@jai/coding-agent": "workspace:*",
		"@jai/connector": "workspace:*",
		"@jai/extension": "workspace:*",
		"@jai/server": "workspace:*",
		"@lobehub/icons": "^5.15.0",
		"@lobehub/streamdown": "^1.3.1",
		"@monaco-editor/react": "^4.7.0",
		"@pierre/diffs": "1.3.5",
		"@pierre/trees": "^1.0.0-beta.6",
		"@radix-ui/react-slot": "^1.3.3",
		"@shikijs/core": "4.4.3",
		"@shikijs/langs": "4.4.3",
		"@shikijs/stream": "^4.4.3",
		"@shikijs/themes": "4.4.3",
		"@sinclair/typebox": "catalog:",
		"@tanstack/react-query": "^5.90.21",
		"@tanstack/react-virtual": "^3.14.13",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/xterm": "^6.0.0",
		"ai": "^6.0.146",
		"better-result": "^3.0.0",
		"boring-avatars": "^2.0.4",
		"class-variance-authority": "^0.7.1",
		"cn": "^0.2.6",
		"electron-log": "^5.4.4",
		"electron-store": "^11.0.2",
		"framer-motion": "^12.43.0",
		"lucide-react": "^1.28.0",
		"motion": "^12.38.0",
		"node-pty": "^1.1.0",
		"pdfjs-dist": "^6.2.108",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"react-intl": "10.1.25",
		"react-router": "7",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"shiki": "^4.4.3",
		"thinking-orbs": "^0.2.0",
		"tree-sitter-bash": "0.25.0",
		"tw-animate-css": "^1.4.0",
		"tw-shimmer": "^0.4.12",
		"unicode-animations": "^1.0.3",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.1.0",
		"web-tree-sitter": "0.25.10",
		"zustand": "^5.0.12"
	},
	"devDependencies": {
		"@electron-forge/cli": "^7.11.2",
		"@electron-forge/maker-deb": "^7.11.2",
		"@electron-forge/maker-squirrel": "^7.11.2",
		"@electron-forge/maker-zip": "^7.11.2",
		"@electron-forge/plugin-fuses": "^7.11.2",
		"@electron-forge/plugin-vite": "^7.11.2",
		"@electron-forge/shared-types": "^7.11.2",
		"@electron/fuses": "^2.1.3",
		"@formatjs/cli": "6.16.22",
		"@tailwindcss/vite": "^4.1.0",
		"@types/mdast": "^4.0.4",
		"@types/node": "^24.0.0",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^5.2.0",
		"code-inspector-plugin": "^1.4.5",
		"electron": "42.7.0",
		"react-scan": "^0.5.7",
		"shadcn": "^4.1.2",
		"tailwindcss": "^4.1.0",
		"typescript": "catalog:",
		"vite": "^7.3.6"
	}
}
