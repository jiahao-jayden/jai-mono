{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"emitDecoratorMetadata": false,
		"experimentalDecorators": false,
		"noEmit": false,
		"declaration": true,
		"emitDeclarationOnly": true,
		"declarationMap": true,
		"rootDir": "./src",
		"outDir": "./dist"
	},
	"include": [
		"src/**/*"
	]
}
