{
	"name": "@jai/trajectory-ui",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Host-neutral React trajectory timeline for Jai.",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./style.css": "./dist/style.css"
	},
	"scripts": {
